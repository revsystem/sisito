<% uniq_recipient_count = @uniq_count_by_destination.values.sum %>
<div class="page-header">
  <span class="glyphicon glyphicon-stats"></span>
  Unique Recipient Bounced
  <span class="text-muted"><%= stats_period_label(@recent_days_from, @recent_days_to) %></span>
  <span class="text-muted">(<%= uniq_recipient_count %> recipients)</span>
</div>

<% if @uniq_count_by_destination.blank? && @uniq_count_by_reason.blank? && @uniq_count_by_sender.blank? %>
  <p class="text-muted">No data in this period.</p>
<% end %>

<section>
  <div class="col-sm-4">
    <div id="uniq_count_by_destination"></div>
  </div>
  <div class="col-sm-4">
    <div id="uniq_count_by_reason"></div>
  </div>
  <div class="col-sm-4">
    <div id="uniq_count_by_sender"></div>
  </div>
</section>

<% if @uniq_count_by_destination.present? %>
  <%= javascript_tag do %>
    c3.generate({
      bindto: '#uniq_count_by_destination',
      data: {
        columns: <%= raw chart_columns(@uniq_count_by_destination).inspect %>,
        type: 'donut'
      },
      donut: {
        title: '<%= uniq_recipient_count %> recipients',
      }
    });
  <% end %>
<% end %>

<% if @uniq_count_by_reason.present? %>
  <%= javascript_tag do %>
    c3.generate({
      bindto: '#uniq_count_by_reason',
      data: {
        columns: <%= raw chart_columns(@uniq_count_by_reason).inspect %>,
        type : 'pie'
      }
    });
  <% end %>
<% end %>

<% if @uniq_count_by_sender.present? %>
  <%= javascript_tag do %>
    c3.generate({
      bindto: '#uniq_count_by_sender',
      data: {
        columns: <%= raw chart_columns(@uniq_count_by_sender).inspect %>,
        type : 'pie'
      }
    });
  <% end %>
<% end %>
